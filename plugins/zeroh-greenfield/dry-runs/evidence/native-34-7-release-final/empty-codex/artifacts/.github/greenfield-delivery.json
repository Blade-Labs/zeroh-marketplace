{
  "schemaVersion": 1,
  "archetype": "library-cli",
  "setupArgv": [
    [
      "env",
      "npm_config_cache=.npm-cache",
      "npm_config_logs_dir=.npm-logs",
      "npm",
      "ci",
      "--no-audit",
      "--no-fund"
    ]
  ],
  "affectedArgv": [
    "env",
    "TSX_DISABLE_CACHE=1",
    "node",
    "--import",
    "tsx",
    "--test"
  ],
  "affectedFallbackReason": "The two-file greeting package has no dependency-aware affected selector; PR checks intentionally execute the complete real test suite.",
  "shardCount": 2,
  "evidenceDays": 7,
  "baseline": {
    "minTests": 10,
    "minUnits": 2,
    "coverageFloor": 80
  },
  "baselineApproval": {
    "bootstrap": true,
    "baseSha": null,
    "previous": null,
    "previousDigest": "74234e98afe7498fb5daf1f36ac2d78acc339464f950703b8c019892f982b90b",
    "approvedDigest": "319632c9b81815e28168382a6af23c0036d1bcbeaca1151824dee62664f35bd7",
    "owner": "fixture-owner",
    "reason": "Initial delivery baseline presented for approval with fixture setup"
  },
  "operationalRoots": [
    ".ci",
    "node_modules",
    ".npm-cache",
    ".npm-logs"
  ],
  "adapterConfig": {
    "maxInfraRetries": 0,
    "coverageRoots": [],
    "leafTasks": {}
  },
  "runners": {
    "node:test": {
      "inventoryArgv": [
        "git",
        "ls-files",
        "-z",
        "--",
        "test",
        "tests"
      ],
      "inventoryFormat": "git-nul",
      "filePattern": "\\.test\\.mjs$",
      "shardArgv": [
        "node",
        "--import",
        "tsx",
        "--test",
        "--experimental-test-coverage",
        "--test-reporter=junit",
        "--test-reporter-destination={junit}",
        "--test-reporter=lcov",
        "--test-reporter-destination={coverage}",
        "{unit}"
      ],
      "env": {
        "TSX_DISABLE_CACHE": "1"
      },
      "rawReports": [
        {
          "path": "{junit}",
          "format": "junit"
        },
        {
          "path": "{coverage}",
          "format": "lcov"
        }
      ]
    }
  },
  "build": {
    "argv": [
      "env",
      "npm_config_cache=.npm-cache",
      "npm_config_logs_dir=.npm-logs",
      "npm",
      "run",
      "build"
    ],
    "outputs": [
      "dist"
    ]
  },
  "release": {
    "environment": "greenfield-validation",
    "provider": "none"
  }
}
