{
  "$schema": "./roadmap.config.schema.json",
  "configVersion": 1,
  "gateCommands": {
    "lint": "none",
    "types": "npm run typecheck",
    "unit": "node --test test/greet.test.ts test/cli.test.ts",
    "integration": "node dist/cli.js --help",
    "build": "npm run build",
    "e2e": "none",
    "emit": "env TSX_DISABLE_CACHE=1 node --import tsx roadmap/lib/emit.ts"
  },
  "testCadence": {
    "enabled": true,
    "backstop": ".github/workflows/ci.yml (authoritative full suite on main/manual runs)"
  },
  "designHomes": {
    "architecture": {
      "home": "docs/architecture.md"
    },
    "ux": {
      "canon": [
        "docs/ux-canon.md"
      ]
    }
  },
  "testConventions": [
    "node --test test/greet.test.ts test/cli.test.ts",
    "node dist/cli.js --help"
  ]
}
