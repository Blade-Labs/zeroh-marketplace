{
  "description": "zeroh-sdd v1 runtime hooks — executable stage gates, proof receipts, JIT checks, and AP envelopes",
  "hooks": {
    "Setup": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook setup",
            "statusMessage": "Initializing zeroh-sdd runtime..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook session-start",
            "statusMessage": "Loading zeroh-sdd execution state..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook user-prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-tool-write",
            "statusMessage": "Checking active SDD stage..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-tool-bash",
            "statusMessage": "Checking SDD stage advance..."
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-tool-bash",
            "statusMessage": "Checking SDD stage advance..."
          },
          {
            "type": "command",
            "if": "Bash(git merge *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-tool-bash",
            "statusMessage": "Checking SDD stage advance..."
          },
          {
            "type": "command",
            "if": "Bash(zeroh-sdd stage set *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-tool-bash",
            "statusMessage": "Checking SDD stage advance..."
          },
          {
            "type": "command",
            "if": "Bash(node *zeroh-sdd.mjs stage set *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-tool-bash",
            "statusMessage": "Checking SDD stage advance..."
          },
          {
            "type": "command",
            "if": "Bash(sdd:stage set *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-tool-bash",
            "statusMessage": "Checking SDD stage advance..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook post-tool-write",
            "statusMessage": "Scanning for SDD antipatterns..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook post-tool-write-jit",
            "asyncRewake": true,
            "timeout": 300,
            "statusMessage": "Running SDD JIT checks..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook post-tool-bash"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook post-tool-failure"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook task-completed"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook stop"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|project_settings|local_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook config-change"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/zeroh-sdd.mjs\" hook session-end"
          }
        ]
      }
    ]
  }
}
