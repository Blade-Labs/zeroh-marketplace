# .env tracked in this private-marketplace repo: it ships shared demo
# Hedera testnet creds (account 0.0.8961018) so installs work out of the box.
# Override locally with real shell env vars or a per-project <project>/.zeroh.env.
.zeroh.env
node_modules/
.zeroh/

# Blade-bound VI fixtures: regenerated on every test/demo run by
# `vi-fixture-gen.mjs --agent-from-blade=...`. The vanilla l1.sdjwt /
# l2.sdjwt / mandate.json / *-key.json fixtures stay committed (Phase E.1
# baseline). The *-blade* variants are ephemeral test artifacts.
test/fixtures/vi/*-blade.sdjwt
test/fixtures/vi/*-blade.json
