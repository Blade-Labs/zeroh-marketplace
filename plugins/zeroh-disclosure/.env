# ZeroH Disclosure — shared testnet credentials for the private marketplace.
#
# These are SHARED DEMO credentials, intentionally committed so anyone
# installing the plugin from this private marketplace can anchor receipts
# without first running a setup wizard. The account is testnet-only and
# holds testnet HBAR worth $0. Override locally if you want your own
# identity:
#   - Set HEDERA_OPERATOR_* in your shell, OR
#   - Drop a <project>/.zeroh.env next to your code (gitignored).
# Real env vars and <project>/.zeroh.env both win over this file.
#
# Rotate this account if it gets abused or runs out of HBAR. Refill at:
#   https://portal.hedera.com/faucet

ZEROH_ANCHOR=1

HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.8961018
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420764ade8ac4c9a7ab92329571af3c44ce46cde1f8724bb5dedd37206e65f2aa45

# HCS topic for anchoring receipts. Mint one with:
#   node scripts/finalize-anchor-setup.mjs
# Run from a machine with gRPC egress to *.hedera.com:50211 (i.e. NOT a
# Claude-Code-on-the-web sandbox). It will write the resulting topic id
# back into this file.
# HEDERA_TOPIC_ID=

# EVM-anchor fallback: when HCS submission fails (e.g. running inside a
# sandbox that blocks Hedera gRPC), the Stop hook signs an Ethereum
# transaction with the 32-byte receipt hash as calldata and submits it via
# Hashio JSON-RPC over HTTPS-443. ECDSA-keyed account required for EVM
# signing. Confirm on-chain at https://hashscan.io/testnet/account/0.0.8958577
HEDERA_EVM_OPERATOR_ID=0.0.8958577
HEDERA_EVM_OPERATOR_KEY=0x466b1573bfdc04e161f820747d32f7d956c7d80ea19578e1df901b303b14fb72

# Receipt boundary metadata (recorded in every receipt; does not affect masking)
ZEROH_DESTINATION=anthropic_claude_api
ZEROH_MODEL=claude-code
ZEROH_RETENTION=unknown
ZEROH_DESTINATION_JURISDICTION=US
