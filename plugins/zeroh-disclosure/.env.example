# ZeroH Disclosure configuration.
#
# Copy this file to one of:
#   - <project>/.zeroh.env   (per-project — recommended for marketplace installs)
#   - <plugin>/.env          (works for local dev installs; lost on plugin update)
#
# Real environment variables (exported in your shell) always win over the file.
# Lines starting with # are comments. `export KEY=...` is also tolerated so you
# can `source` this file if you want.

# ---------------------------------------------------------------------------
# Policy + protection engine
# ---------------------------------------------------------------------------

# qcb | blade | agent. A project can also set a plain-text .zeroh.policy file.
ZEROH_POLICY=qcb

# Agent accountability mode is policy/env driven. With ZEROH_POLICY=agent and
# ZEROH_REQUIRE_INTENT=1, commerce-tier tools fail closed unless a valid VI
# mandate is loaded.
# ZEROH_REQUIRE_INTENT=1

# regex-local | presidio-http. Leave unset to let the active policy choose.
# Blade prefers presidio-http and can fall back to regex-local in dev mode.
# ZEROH_PROTECTION_ENGINE=presidio-http

# fallback_with_receipt | fail_closed
ZEROH_POLICY_MODE=fallback_with_receipt

# Presidio sidecar endpoints. Start with:
#   docker compose -f docker-compose.presidio.yml up
PRESIDIO_ANALYZER_URL=http://localhost:5002/analyze
PRESIDIO_ANONYMIZER_URL=http://localhost:5001/anonymize

# ---------------------------------------------------------------------------
# Hedera anchoring (live HCS submission of the receipt hash at turn end)
# ---------------------------------------------------------------------------

# Set to 1 to actually submit anchors. Defaults to off (anchor intent still
# recorded in the receipt, just not transmitted).
ZEROH_ANCHOR=0

# testnet | mainnet
HEDERA_NETWORK=testnet

# Your Hedera operator account that pays for HCS submissions.
HEDERA_OPERATOR_ID=0.0.xxxxxx

# Operator private key — DER hex or ED25519/ECDSA hex. Sensitive: keep this
# file out of version control.
HEDERA_OPERATOR_KEY=302e02...

# HCS topic to submit anchors to. Create one with:
#   node scripts/create-topic.mjs
HEDERA_TOPIC_ID=0.0.yyyyyy

# HCS reliability knobs. request timeout must be greater than grpc deadline.
ZEROH_HCS_GRPC_DEADLINE_MS=10000
ZEROH_HCS_TIMEOUT_MS=30000
ZEROH_HCS_MAX_ATTEMPTS=4

# Optional HTTPS/EVM fallback. If HCS fails and these are configured, ZeroH
# anchors the receipt hash as EVM calldata through Hashio and records the HCS
# failed attempt in the receipt.
# HEDERA_EVM_OPERATOR_ID=0.0.zzzzzz
# HEDERA_EVM_OPERATOR_KEY=0x...

# ---------------------------------------------------------------------------
# Receipt boundary metadata (recorded in every receipt; does not affect masking)
# ---------------------------------------------------------------------------

# What the receipt should say the data was sent to.
ZEROH_DESTINATION=anthropic_claude_api
ZEROH_MODEL=claude-code

# Retention class declared by the AI provider. One of:
#   zdr | none | customer_managed | provider_default | unknown
# Affects which policy rule fires (see policies/qcb-ai-disclosure.v1.js).
ZEROH_RETENTION=unknown

# ISO country code where the AI provider processes data.
ZEROH_DESTINATION_JURISDICTION=US

# ---------------------------------------------------------------------------
# Blade SDK + Hedera-rooted agent identity (Phase F-1)
# Required only when using the BladeWallet adapter (agent identity rooted
# in did:hedera with HCS-14 UAID). Bootstrap via:
#   node scripts/blade-agent-bootstrap.mjs
# ---------------------------------------------------------------------------

# Blade SDK credentials (commercial — Blade Labs onboarding).
ZEROH_BLADE_API_KEY=
ZEROH_BLADE_DAPP_CODE=

# After bootstrap, point at the generated config blob. Defaults to
# <plugin>/.zeroh/blade-agent.json if unset.
ZEROH_BLADE_AGENT_CONFIG=
