{
  "description": "zeroh-roadmap runtime hooks — validate roadmap files at write time so a malformed phase/arc/backlog file never lands (the import-time Zod parse IS the validator), block the known-broken integration-test scoping forms that silently run the full suite, and stamp wall-clock time into each prompt for in-session pacing",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/time-stamp.sh\" || exit 0",
            "statusMessage": "Stamping the wall clock..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/scoping-guard.sh\"; c=$?; [ \"$c\" -eq 2 ] && exit 2; exit 0",
            "statusMessage": "Checking test-scoping form..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fail-soft.mjs\" \"${CLAUDE_PLUGIN_ROOT}/bin/validate-roadmap-file.mjs\"",
            "statusMessage": "Validating roadmap file..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/beacon-stamp.sh\" || exit 0",
            "statusMessage": "Stamping executor beacon..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fail-soft.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session-lane-check.mjs\"",
            "statusMessage": "Checking armed lanes for reaped executors..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fail-soft.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/executor-result-guard.mjs\"",
            "statusMessage": "Checking executor result contract..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/fail-soft.mjs\" \"${CLAUDE_PLUGIN_ROOT}/hooks/executor-result-guard.mjs\"",
            "statusMessage": "Checking executor result contract..."
          }
        ]
      }
    ]
  }
}
