{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "configVersion": {
      "type": "number",
      "const": 1
    },
    "gateCommands": {
      "type": "object",
      "properties": {
        "lint": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "integration": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        },
        "e2e": {
          "type": "string",
          "minLength": 1
        },
        "emit": {
          "type": "string",
          "minLength": 1
        },
        "unit-scoped": {
          "type": "string",
          "minLength": 1
        },
        "integration-scoped": {
          "type": "string",
          "minLength": 1
        },
        "unit-impacted": {
          "type": "string",
          "minLength": 1
        },
        "integration-impacted": {
          "type": "string",
          "minLength": 1
        },
        "unit-affected": {
          "type": "string",
          "minLength": 1
        },
        "integration-affected": {
          "type": "string",
          "minLength": 1
        },
        "lint-diff": {
          "type": "string",
          "minLength": 1
        },
        "types-web": {
          "type": "string",
          "minLength": 1
        },
        "ratchets": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "lint",
        "types",
        "unit",
        "integration",
        "build",
        "e2e",
        "emit"
      ],
      "additionalProperties": false
    },
    "gateConditionalSlots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "whenDiffMatches": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "slot": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "whenDiffMatches",
          "slot"
        ],
        "additionalProperties": false
      }
    },
    "lintDiffMatches": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "executionIsolation": {
      "type": "string",
      "enum": [
        "primary",
        "worktree"
      ]
    },
    "testCadence": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backstop": {
          "type": "string"
        },
        "floors": {
          "type": "string",
          "enum": [
            "blocking",
            "advisory",
            "none"
          ]
        },
        "build": {
          "type": "string",
          "enum": [
            "phase",
            "arc-end"
          ]
        }
      },
      "additionalProperties": false
    },
    "mergePolicy": {
      "type": "object",
      "properties": {
        "arcIntegration": {
          "type": "string",
          "enum": [
            "autonomous",
            "hold"
          ]
        },
        "maxOpenFollowups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "autonomousPushRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "primaryCheckout": {
          "type": "string"
        },
        "staleBaseCeiling": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "arcEndSuite": {
          "type": "string",
          "enum": [
            "full",
            "impacted",
            "defer-ci"
          ]
        },
        "gapsCorrection": {
          "type": "string",
          "enum": [
            "autonomous",
            "hold"
          ]
        }
      },
      "required": [
        "arcIntegration",
        "maxOpenFollowups",
        "autonomousPushRefs",
        "primaryCheckout"
      ],
      "additionalProperties": false
    },
    "modelPolicy": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "claude",
            "codex",
            "codex-full"
          ]
        },
        "default": {
          "type": "string",
          "enum": [
            "fable",
            "sonnet",
            "opus",
            "sol"
          ]
        },
        "roles": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "fable",
              "sonnet",
              "opus",
              "sol"
            ]
          }
        },
        "judgeModel": {
          "type": "string",
          "enum": [
            "fable",
            "sonnet",
            "opus",
            "sol"
          ]
        }
      },
      "additionalProperties": false
    },
    "gateSpecialists": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "agent": {
            "type": "string"
          }
        },
        "required": [
          "paths",
          "agent"
        ],
        "additionalProperties": false
      }
    },
    "validationTiers": {
      "type": "object",
      "properties": {
        "wired": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "scopedSlot": {
              "type": "string"
            },
            "variants": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "live-ui": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "scopedSlot": {
              "type": "string"
            },
            "variants": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "live-host": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "scopedSlot": {
              "type": "string"
            },
            "variants": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "designHomes": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "object",
          "properties": {
            "home": {
              "type": "string"
            },
            "extendProtocol": {
              "type": "string"
            }
          },
          "required": [
            "home"
          ],
          "additionalProperties": false
        },
        "ux": {
          "type": "object",
          "properties": {
            "canon": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "qualityExemplar": {
              "type": "string"
            },
            "copyRules": {
              "type": "string"
            },
            "bindingDesignSystem": {
              "type": "string"
            },
            "superseded": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reviewFocus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          },
          "guidance": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "signature",
          "guidance"
        ],
        "additionalProperties": false
      }
    },
    "testConventions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exec": {
      "type": "object",
      "properties": {
        "preReview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "longRunWrapper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "capacity": {
      "type": "object",
      "properties": {
        "memPerExecutorMb": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "minFreeMemMb": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "loadPerExecutor": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxExecutors": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "worktreeGc": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "inactiveObservations": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "inactiveIntervalMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "deleteIntegratedBranches": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "configVersion",
    "gateCommands"
  ],
  "additionalProperties": false
}
