{
  "$schema": "../../plugins/zeroh-roadmap/cli/roadmap.config.schema.json",
  "configVersion": 1,
  "gateCommands": {
    "lint": "none",
    "types": "none",
    "unit": "bash -c 'cd plugins/zeroh-roadmap && capbuild npm test'",
    "integration": "none",
    "build": "none",
    "e2e": "none",
    "emit": "none",
    "unit-scoped": "capbuild node plugins/zeroh-roadmap/scripts/run-scoped-tests.mjs {fileArgs}"
  },
  "validationTiers": {
    "wired": {
      "command": "node plugins/zeroh-roadmap/bin/roadmap.mjs",
      "notes": "wired criteria drive the plugin CLI; each criterion signal names its own subcommand. live-ui and live-host stay unbound — this consumer has no UI surface and no deployed host."
    }
  },
  "modelPolicy": {
    "preset": "codex"
  },
  "designHomes": {
    "architecture": {
      "home": "plugins/zeroh-roadmap",
      "extendProtocol": "Extend plugins/zeroh-roadmap/MULTI-DRIVER.md in place; every trim of a model-loaded skill or agent card takes a DIET-LEDGER.md disposition row in the same commit."
    }
  },
  "mergePolicy": {
    "autonomousPushRefs": [
      "feat/roadmap-arcs"
    ],
    "arcIntegration": "hold",
    "gapsCorrection": "hold",
    "maxOpenFollowups": 10,
    "primaryCheckout": "/home/patrik/zeroh-marketplace"
  }
}
